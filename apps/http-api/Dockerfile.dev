# syntax=docker/dockerfile:1.7
###############################################################################
# http-api — development image.
#
# Multi-stage: pinned pnpm base -> full workspace install -> hot-reload runner.
# Unlike the prod image this keeps devDependencies (tsx, typescript) and does
# NOT bake sources — compose bind-mounts the repo over /app so edits hot-reload.
#
# Built from the MONOREPO ROOT as context:
#   docker build -f apps/http-api/Dockerfile.dev .
###############################################################################

ARG NODE_VERSION=22-alpine
# Keep in lockstep with the root package.json "packageManager" field.
ARG PNPM_VERSION=10.19.0

# ---------------------------------------------------------------------------
# base — the exact pinned pnpm.
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS base
ARG PNPM_VERSION
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME/bin:$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /app

# ---------------------------------------------------------------------------
# deps — install the full workspace (dev deps included). Only manifests are
# copied first so this layer caches until a package.json or the lockfile moves.
# ---------------------------------------------------------------------------
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc* ./
COPY apps/http-api/package.json ./apps/http-api/
COPY packages/auth/package.json ./packages/auth/
COPY packages/db/package.json ./packages/db/
COPY packages/game/package.json ./packages/game/
COPY packages/protocol/package.json ./packages/protocol/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/typescript-config/package.json ./packages/typescript-config/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# ---------------------------------------------------------------------------
# dev — sources arrive via bind mount; we only need the Prisma client generated
# and the workspace packages built so `tsx` can resolve @repo/* at runtime.
# ---------------------------------------------------------------------------
FROM base AS dev
ENV NODE_ENV=development

COPY --from=deps /app ./
COPY . .

# Prisma's generated client lives outside src/, so it must exist before boot.
# Workspace packages compile to dist/, which the app imports.
RUN pnpm --filter @repo/db exec prisma generate \
 && pnpm dlx turbo@^2 run build --filter=@repo/protocol --filter=@repo/game --filter=@repo/auth --filter=@repo/db

WORKDIR /app/apps/http-api

ENV HTTP_API_HOST=0.0.0.0
ENV HTTP_API_PORT=4001
EXPOSE 4001

# tsx watch restarts on any change under the bind-mounted source tree.
CMD ["pnpm", "dev"]
