# syntax=docker/dockerfile:1.7
###############################################################################
# judge-worker — development image.
#
# Multi-stage: pinned pnpm base -> full workspace install -> hot-reload runner.
# Keeps devDependencies (tsx, typescript). Compose bind-mounts the repo over
# /app so source edits hot-reload via `tsx watch`. No port — queue consumer.
#
# Built from the MONOREPO ROOT as context:
#   docker build -f apps/judge-worker/Dockerfile.dev .
###############################################################################

ARG NODE_VERSION=22-alpine
ARG PNPM_VERSION=10.19.0

FROM node:${NODE_VERSION} AS base
ARG PNPM_VERSION
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME/bin:$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /app

# ---------------------------------------------------------------------------
# deps — manifests only, so the install layer caches until a package.json moves.
# ---------------------------------------------------------------------------
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc* ./
COPY apps/judge-worker/package.json ./apps/judge-worker/
COPY packages/db/package.json ./packages/db/
COPY packages/game/package.json ./packages/game/
COPY packages/protocol/package.json ./packages/protocol/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/typescript-config/package.json ./packages/typescript-config/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# ---------------------------------------------------------------------------
# dev — generated Prisma client + workspace dist/ must exist before boot.
# ---------------------------------------------------------------------------
FROM base AS dev
ENV NODE_ENV=development

COPY --from=deps /app ./
COPY . .

RUN pnpm dlx turbo@^2 run build \
      --filter=@repo/protocol --filter=@repo/game --filter=@repo/db

WORKDIR /app/apps/judge-worker

CMD ["pnpm", "dev"]
