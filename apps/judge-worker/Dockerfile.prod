# syntax=docker/dockerfile:1.7
###############################################################################
# judge-worker — production image.
#
# Stages: base -> pruner -> deps (full) -> build -> prod-deps -> runner
# This app is a BullMQ consumer: it exposes no HTTP port, so its healthcheck
# probes Redis reachability rather than an endpoint.
#
# Built from the MONOREPO ROOT as context:
#   docker build -f apps/judge-worker/Dockerfile.prod .
###############################################################################

ARG NODE_VERSION=22-alpine
# Keep in lockstep with the root package.json "packageManager" field.
ARG PNPM_VERSION=10.19.0

# ---------------------------------------------------------------------------
# base — the exact pinned pnpm, shared by every later stage.
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION} AS base
ARG PNPM_VERSION
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME/bin:$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /app

# ---------------------------------------------------------------------------
# pruner — keep only this app and its workspace deps.
# ---------------------------------------------------------------------------
FROM base AS pruner
COPY . .
RUN pnpm dlx turbo@^2 prune judge-worker --docker

# ---------------------------------------------------------------------------
# deps — full install (dev deps included) for the build.
# ---------------------------------------------------------------------------
FROM base AS deps
COPY --from=pruner /app/out/json/ ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# ---------------------------------------------------------------------------
# build — prisma generate (via @repo/db) then tsc.
# ---------------------------------------------------------------------------
FROM base AS build
COPY --from=deps /app/ ./
COPY --from=pruner /app/out/full/ ./
RUN pnpm dlx turbo@^2 run build --filter=judge-worker

# ---------------------------------------------------------------------------
# prod-deps — runtime modules only.
# ---------------------------------------------------------------------------
FROM base AS prod-deps
COPY --from=pruner /app/out/json/ ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod --ignore-scripts

# ---------------------------------------------------------------------------
# runner — non-root, runtime modules + compiled JS only.
# ---------------------------------------------------------------------------
FROM base AS runner
ENV NODE_ENV=production

RUN addgroup -g 1001 -S nodejs && adduser -S -u 1001 -G nodejs appuser

COPY --from=prod-deps --chown=appuser:nodejs /app ./

COPY --from=build --chown=appuser:nodejs /app/apps/judge-worker/dist ./apps/judge-worker/dist
COPY --from=build --chown=appuser:nodejs /app/packages/protocol/dist ./packages/protocol/dist
COPY --from=build --chown=appuser:nodejs /app/packages/game/dist ./packages/game/dist
COPY --from=build --chown=appuser:nodejs /app/packages/db/dist ./packages/db/dist
COPY --from=build --chown=appuser:nodejs /app/packages/db/generated ./packages/db/generated

USER appuser
WORKDIR /app/apps/judge-worker

# No port: this is a queue consumer. Liveness = the node process is alive and
# Piston answers, which is the dependency most likely to be misconfigured.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD node -e "fetch(process.env.PISTON_URL+'/runtimes').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/index.js"]
