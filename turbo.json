{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "CORS_ORIGINS",
    "HTTP_API_PORT",
    "HTTP_API_HOST",
    "WS_SERVER_PORT",
    "WS_SERVER_HOST",
    "COUNTDOWN_MS",
    "TIMER_TICK_MS",
    "HEARTBEAT_TIMEOUT_MS",
    "MAX_PENDING_SUBMISSIONS_PER_USER",
    "PISTON_URL",
    "JUDGE_CONCURRENCY",
    "JUDGE_RUN_TIMEOUT_MS",
    "JUDGE_COMPILE_TIMEOUT_MS",
    "JUDGE_MAX_OUTPUT_BYTES",
    "JUDGE_HTTP_TIMEOUT_MS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
